FROM node:20-alpine
WORKDIR /app
COPY package.json package-lock.json* ./
COPY packages ./packages
COPY apps/api ./apps/api
RUN npm install --workspaces --include-workspace-root 2>/dev/null || npm install
RUN npm run build -w packages/shared && npm run build -w packages/detection && npm run build -w packages/security && npm run build -w apps/api
ENV NODE_ENV=production
ENV PORT=3001
EXPOSE 3001
CMD ["node", "apps/api/dist/index.js"]
