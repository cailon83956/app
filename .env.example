# Server
PORT=3001
NODE_ENV=production
DATA_DIR=/data/uab

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# Android SDK (worker)
ANDROID_HOME=/opt/android-sdk
ANDROID_SDK_ROOT=/opt/android-sdk
JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64

# Limits
MAX_UPLOAD_SIZE=200MB
JOB_TTL_HOURS=24
